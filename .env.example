# Hugging Face token — required to download the pyannote speaker-diarization
# model that WhisperX uses. Accept the model terms at:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
# then create a read token at https://huggingface.co/settings/tokens
HF_TOKEN=

# --- AI (decides what to cut, picks highlights and shorts, writes chapters) --
# openai (default) or gemini (optional fallback, below).
LLM_PROVIDER=openai
# Create a key at https://platform.openai.com/api-keys (the account needs
# billing/credit). gpt-6-luna is OpenAI's budget model: a 98-minute meeting
# costs about $0.02 (~100k input + ~15k output tokens).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# none = no reasoning tokens (cheaper, faster; the task doesn't need them).
OPENAI_REASONING_EFFORT=none

# Optional fallback: only used when LLM_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# WhisperX runs locally/self-hosted (no per-minute cost). "small"/"base" are
# CPU-friendly; use "large-v3" if you have a GPU. int8 keeps CPU inference fast.
WHISPERX_MODEL=small
WHISPERX_DEVICE=cpu
WHISPERX_COMPUTE_TYPE=int8
WHISPERX_DIARIZE_MODEL=pyannote/speaker-diarization-3.1

# Where uploaded videos, intermediate clips, and job state are stored.
STORAGE_DIR=./storage

FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# --- v2 service -----------------------------------------------------------
# Operator key (the pre-accounts shared secret): accepted as X-API-Key on
# every API route with admin rights, so existing n8n flows keep working.
# Prefer a per-user API key (created on the site's API keys page), then
# leave this empty.
HC_API_TOKEN=
# Jobs allowed at once across all users (running + waiting); more get 503.
MAX_QUEUE_DEPTH=10
# Refuse to start a job with less free disk than this (bytes, 6 GiB).
MIN_FREE_DISK_BYTES=6442450944
# Delete finished jobs older than this many hours at startup (0 = never).
JOB_RETENTION_HOURS=0
# Dissolves between kept parts (false = hard cuts) and their target length.
TRANSITIONS_ENABLED=true
TRANSITION_TARGET_S=0.5
# Cut the pauses where nobody is speaking, measured in the audio (captions
# can't show them). A pause of >= SILENCE_MIN_S is shortened to a ~0.55 s
# beat: PAD_AFTER is left after speech stops, PAD_BEFORE before it resumes.
# The level that counts as silence adapts to each recording (room tone vs
# speech level); the three dB knobs tune that rule (see core/config.py).
# The UI's "Cut silences" box overrides SILENCE_CUT_ENABLED per job.
SILENCE_CUT_ENABLED=true
SILENCE_MIN_S=1.0
SILENCE_PAD_AFTER_S=0.30
SILENCE_PAD_BEFORE_S=0.25
SILENCE_MIN_MARGIN_DB=6
SILENCE_RANGE_FRACTION=0.35
SILENCE_SPEECH_HEADROOM_DB=18

# --- v2 outputs -----------------------------------------------------------
# Font file for burned-in text (labels, title card, captions). Empty = find
# DejaVu Sans (Linux: apt install fonts-dejavu-core) or Arial automatically.
FONT_FILE=
# "<topic> / Full meeting" card between the highlights reel and the meeting
# in final.mp4, in seconds (0 = none).
TITLE_CARD_S=2
# Also ship the reel on its own / a separate copy of the cleaned meeting.
HIGHLIGHTS_FILE_ENABLED=true
KEEP_CLEANED_SEPARATELY=false
# After the zip is written keep the individual files (true, local UI) or
# only the zip + manifest (false, recommended on a small server).
SERVE_INDIVIDUAL_ARTIFACTS=true
# Delete the source recording (inside the job folder) when the job is done.
DELETE_SOURCE_WHEN_DONE=false

# --- Zoom (Server-to-Server OAuth app) -------------------------------------
# From the app's "App credentials" page. The app must be ACTIVATED and have
# the scopes cloud_recording:read:list_user_recordings:admin,
# cloud_recording:read:list_recording_files:admin and
# cloud_recording:read:recording:admin.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Whose cloud recordings the web UI lists by default (an email address).
ZOOM_HOST_EMAIL=
# Never run WhisperX: fail with transcript_not_ready instead (true on EC2).
REQUIRE_NATIVE_TRANSCRIPT=false

# --- Site, accounts and API keys (plan.MD) ---------------------------------
# dev (local) or prod (public server: the app refuses to start unless
# JWT_SECRET, an https APP_BASE_URL and a real email backend are set).
APP_ENV=dev
APP_NAME=Highlight Cutter
# The public address of the site (email links and webhook payloads use it).
APP_BASE_URL=http://127.0.0.1:8000
# Signs login sessions. Generate one (keep it secret, never commit it):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Empty in dev = a random secret stored in storage/dev_jwt_secret.
JWT_SECRET=
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30
# Empty = SQLite file storage/app.db (fine for one server). Postgres:
#   DATABASE_URL=postgresql+psycopg://user:password@host/dbname
DATABASE_URL=
# Anyone can create an account (true), optionally only from these domains.
SIGNUP_ENABLED=true
ALLOWED_SIGNUP_DOMAINS=
# These addresses become admins once they verify their email (comma list).
# Or create one directly: python -m db.cli create-admin you@example.com
ADMIN_EMAILS=
# Public contact address shown on the About and legal pages.
CONTACT_EMAIL=
# Secure cookies: auto = on when APP_BASE_URL is https.
COOKIE_SECURE=auto
# Behind your own reverse proxy only: take the client IP from X-Forwarded-For.
TRUST_PROXY=false
# Local development only: API calls without credentials act as the operator
# (how the app worked before accounts existed). Never on a server.
DEV_OPEN_API=false

# --- Email (verification, welcome, password reset, "your job is done") ------
# console = printed to the server log (dev) | smtp | resend
EMAIL_BACKEND=console
EMAIL_FROM=Highlight Cutter <no-reply@example.com>
EMAIL_REPLY_TO=
# Any SMTP provider (Amazon SES, Resend, Brevo, Postmark, Gmail app password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# starttls (port 587) | ssl (port 465) | none
SMTP_TLS=starttls
# Or Resend's HTTP API (EMAIL_BACKEND=resend).
RESEND_API_KEY=

# --- Limits ------------------------------------------------------------------
# Jobs one user may have waiting or running at once.
MAX_QUEUED_PER_USER=2
MAX_API_KEYS_PER_USER=10
RATE_LIMIT_ENABLED=true
# Free-plan limits for non-admin users (0 = unlimited).
PLAN_JOBS_PER_MONTH=0
PLAN_MAX_MINUTES=0

# --- Webhooks (POSTed to a job's callback_url when it finishes) --------------
WEBHOOKS_ENABLED=true
WEBHOOK_TIMEOUT_S=10
# Allow http:// callback URLs / hosts on private networks (a self-hosted n8n
# on the same machine or LAN). Keep false on a public server unless needed.
WEBHOOK_ALLOW_HTTP=false
WEBHOOK_ALLOW_PRIVATE=false

# --- Misc ----------------------------------------------------------------------
# The old unprefixed API routes (/jobs, /zoom/...) used by older n8n flows.
# Set false once everything calls /api/v1/...
LEGACY_API_ENABLED=true
# Optional animated 3D background on the home page (heavier page).
HERO_3D=false
# One JSON object per log line (log shipping).
LOG_JSON=false
