# Bare-metal alternative to docker compose (see DEPLOY.md, "Without Docker").
# Install: sudo cp deploy/systemd/highlight-cutter.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now highlight-cutter
# Caddy runs separately (apt install caddy) with deploy/caddy/Caddyfile and
# UPSTREAM=127.0.0.1:8000.
[Unit]
Description=Highlight Cutter (website, API and render worker)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hc
Group=hc
WorkingDirectory=/opt/highlight-cutter
EnvironmentFile=/opt/highlight-cutter/.env
Environment=PYTHONUNBUFFERED=1
Environment=XDG_CACHE_HOME=/opt/highlight-cutter/storage/.cache
# ONE process only: the job queue lives in memory. Never add --workers.
ExecStart=/opt/highlight-cutter/.venv/bin/uvicorn api.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=5
# a running render is marked "interrupted" on restart; give it time to reach a checkpoint
TimeoutStopSec=30

# hardening: the app only writes inside storage/
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/highlight-cutter/storage
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
