   "src": 23,
   "start": 251.04,
   "end": 252.986,
   "speaker": "Ashiana.Griffith",
   "text": "Do you want to go, like, now?",
   "overlap_candidate": false
  },
  {
   "i": 24,
   "src": 24,
   "start": 252.986,
   "end": 257.712,
   "speaker": "Ashiana.Griffith",
   "text": "Like, I mean, we've… I don't… I don't mind, because I don't have much to talk about.",
