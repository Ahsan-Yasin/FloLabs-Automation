   "text": "John.",
   "overlap_candidate": false
  },
  {
   "i": 7,
   "src": 362,
   "start": 1500.41,
   "end": 1509.749,
   "speaker": "mohamed abdelmohsen",
   "text": "And this meeting actually is… Just a friendly meeting, just to know you more, like… Just know you more, so don't worry about this meeting.",
   "overlap_candidate": false
  },
  {
   "i": 8,
   "src": 363,
   "start": 1510.16,
   "end": 1510.82,
   "speaker": "kevani minott",
   "text": "Yeah.",
   "overlap_candidate": false
  },
  {
   "i": 9,
   "src": 364,
   "start": 1512.27,
   "end": 1514.69,
   "speaker": "kevani minott",
   "text": "Alright, so thank you for fixing my toggle.",
   "overlap_candidate": false
  },
  {
   "i": 10,
   "src": 365,
   "start": 1515.63,
   "end": 1518.19,
   "speaker": "mohamed abdelmohsen",
   "text": "It's okay, my friend, it's okay.",
   "overlap_candidate": false
  },
  {
   "i": 11,
   "src": 366,
   "start": 1518.19,
   "end": 1522.03,
   "speaker": "mohamed abdelmohsen",
   "text": "The issue actually, it was something from Togo itself.",
   "overlap_candidate": false
  },
  {
   "i": 12,
   "src": 367,
   "start": 1522.35,
   "end": 1527.52,
   "speaker": "mohamed abdelmohsen",
   "text": "It's not from your caching, from your browser, nor my browser.",
