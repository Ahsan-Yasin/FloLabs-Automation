   "overlap_candidate": false
  },
  {
   "i": 14,
   "src": 369,
   "start": 1529.6035714285715,
   "end": 1532.49,
   "speaker": "mohamed abdelmohsen",
   "text": "And yeah, don't worry, it will not happen again.",
   "overlap_candidate": false
  },
  {
   "i": 15,
   "src": 370,
   "start": 1532.75,
   "end": 1537.259,
   "speaker": "mohamed abdelmohsen",
   "text": "We find a way to fix it, and hopefully it will not happen again.",
   "overlap_candidate": false
  },
  {
   "i": 16,
   "src": 371,
   "start": 1537.26,
   "end": 1537.88,
   "speaker": "kevani minott",
   "text": "Yep.",
   "overlap_candidate": false
  },
  {
