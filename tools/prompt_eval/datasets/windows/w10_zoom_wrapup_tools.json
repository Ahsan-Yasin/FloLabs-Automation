   "src": 372,
   "start": 1537.88,
   "end": 1542.511804878049,
   "speaker": "mohamed abdelmohsen",
   "text": "Anyway, if you have any issue, keep in touch with me, just send me a message.",
   "overlap_candidate": false
  },
  {
   "i": 18,
   "src": 373,
   "start": 1542.511804878049,
   "end": 1549.749,
   "speaker": "mohamed abdelmohsen",
