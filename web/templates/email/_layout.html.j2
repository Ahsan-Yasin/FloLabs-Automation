<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<meta name="supported-color-schemes" content="light">
<title>{{ app_name }}</title>
</head>
<body style="margin:0;padding:0;background:#f4f4f5;-webkit-text-size-adjust:100%;">
<span style="display:none;max-height:0;max-width:0;overflow:hidden;opacity:0;mso-hide:all;font-size:1px;line-height:1px;color:#f4f4f5;">{% block preheader %}{% endblock %}</span>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f4f4f5" style="background:#f4f4f5;">
  <tr>
    <td align="center" style="padding:32px 16px;">
      <!--[if mso]><table role="presentation" width="560" cellpadding="0" cellspacing="0" border="0" align="center"><tr><td><![endif]-->
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;">
        <tr>
          <td style="padding:0 0 16px;font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;font-size:16px;line-height:24px;font-weight:600;letter-spacing:-0.16px;color:#17171a;white-space:nowrap;">
            <span style="display:inline-block;width:6px;height:14px;border-radius:2px;background:#adadaf;vertical-align:-2px;"></span><span style="display:inline-block;width:13px;height:14px;margin:0 12px 0 2px;border-radius:2px;background:#17171a;vertical-align:-2px;"><span style="display:block;width:0;height:0;margin:4px 0 0 5px;border-top:3px solid transparent;border-bottom:3px solid transparent;border-left:4px solid #f4f4f5;"></span></span>{{ app_name }}
          </td>
        </tr>
        <tr>
          <td bgcolor="#ffffff" style="background:#ffffff;border:1px solid #e4e4e7;border-radius:12px;padding:32px 30px;font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.6;color:#17171a;">
{% block content %}{% endblock %}
          </td>
        </tr>
        <tr>
          <td style="padding:20px 0 0;font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;font-size:12px;line-height:1.6;color:#66666e;">
            {% block footer %}You received this email because of an account at <a href="{{ base_url }}" style="color:#66666e;text-decoration:underline;">{{ base_url }}</a>.{% endblock %}
            {% if contact_email %} Questions? Write to <a href="mailto:{{ contact_email }}" style="color:#66666e;text-decoration:underline;">{{ contact_email }}</a>.{% endif %}
            <br>&copy; {{ year }} {{ app_name }}
          </td>
        </tr>
      </table>
      <!--[if mso]></td></tr></table><![endif]-->
    </td>
  </tr>
</table>
</body>
</html>
