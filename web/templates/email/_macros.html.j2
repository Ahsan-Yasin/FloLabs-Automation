{% macro button(href, label) -%}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:24px 0 0;">
  <tr>
    <td bgcolor="#0a62d0" style="border-radius:8px;background:#0a62d0;mso-padding-alt:12px 22px;">
      <a href="{{ href }}" style="display:inline-block;padding:12px 22px;font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;font-size:15px;line-height:20px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:8px;">{{ label }}</a>
    </td>
  </tr>
</table>
{%- endmacro %}

{% macro link_fallback(href) -%}
<p style="margin:0 0 4px;font-size:13px;line-height:1.5;color:#66666e;">If the button doesn't work, paste this address into your browser:</p>
<p style="margin:0;font-size:13px;line-height:1.5;word-break:break-all;"><a href="{{ href }}" style="color:#5c5c63;text-decoration:underline;">{{ href }}</a></p>
{%- endmacro %}

{% macro heading(text) -%}
<h1 style="margin:0 0 14px;font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;font-size:22px;line-height:28px;font-weight:600;letter-spacing:-0.3px;color:#17171a;text-wrap:balance;">{{ text }}</h1>
{%- endmacro %}
