{% macro button(href, label) -%}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:22px 0;">
  <tr>
    <td style="border-radius:10px;background:#111915;">
      <a href="{{ href }}" style="display:inline-block;padding:13px 22px;font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;font-size:15px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:10px;">{{ label }}</a>
    </td>
  </tr>
</table>
{%- endmacro %}

{% macro link_fallback(href) -%}
<p style="margin:0 0 4px;font-size:13px;color:#6b6a60;">If the button doesn't work, paste this address into your browser:</p>
<p style="margin:0;font-size:13px;word-break:break-all;"><a href="{{ href }}" style="color:#2f5fd0;">{{ href }}</a></p>
{%- endmacro %}

{% macro heading(text) -%}
<h1 style="margin:0 0 14px;font-family:Georgia,'Times New Roman',serif;font-size:24px;line-height:1.25;font-weight:bold;color:#111915;">{{ text }}</h1>
{%- endmacro %}
