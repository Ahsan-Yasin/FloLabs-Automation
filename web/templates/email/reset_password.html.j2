{% extends "_layout.html.j2" %}
{% from "_macros.html.j2" import button, link_fallback, heading %}
{% block preheader %}Choose a new password for {{ app_name }}.{% endblock %}
{% block content %}
{{ heading("Reset your password") }}
<p style="margin:0 0 12px;">Hi {{ name or "there" }},</p>
<p style="margin:0;">Someone (hopefully you) asked to reset the password of your {{ app_name }} account.</p>
{{ button(link, "Choose a new password") }}
<p style="margin:24px 0 16px;font-size:14px;line-height:1.55;color:#5c5c63;">The link works for {{ minutes }} minutes and only once. If you didn't ask for this, ignore this email; your password stays the same.</p>
{{ link_fallback(link) }}
{% endblock %}
