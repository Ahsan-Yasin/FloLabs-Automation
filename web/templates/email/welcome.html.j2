{% extends "_layout.html.j2" %}
{% from "_macros.html.j2" import button, heading %}
{% block preheader %}Your email is confirmed. Here is how to get your first meeting cut.{% endblock %}
{% block content %}
{{ heading("You're all set") }}
<p style="margin:0 0 16px;">Hi {{ name or "there" }}, your email is confirmed. Three ways to start:</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
  <tr>
    <td style="padding:1px 0 12px;vertical-align:top;width:34px;"><span style="display:block;width:22px;height:22px;border-radius:11px;background:#17171a;font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;font-size:12px;line-height:22px;font-weight:600;color:#ffffff;text-align:center;">1</span></td>
    <td style="padding:0 0 12px;font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.6;color:#17171a;"><strong style="font-weight:600;">Cut your first meeting.</strong> Paste a YouTube link or upload a recording on the <a href="{{ app_link }}" style="color:#17171a;text-decoration:underline;text-decoration-color:#a1a1aa;text-underline-offset:3px;">dashboard</a>.</td>
  </tr>
  <tr>
    <td style="padding:1px 0 12px;vertical-align:top;width:34px;"><span style="display:block;width:22px;height:22px;border-radius:11px;background:#17171a;font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;font-size:12px;line-height:22px;font-weight:600;color:#ffffff;text-align:center;">2</span></td>
    <td style="padding:0 0 12px;font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.6;color:#17171a;"><strong style="font-weight:600;">Connect an automation.</strong> Create an <a href="{{ keys_link }}" style="color:#17171a;text-decoration:underline;text-decoration-color:#a1a1aa;text-underline-offset:3px;">API key</a> and call the API from n8n, Zapier, Make or a script.</td>
  </tr>
  <tr>
    <td style="padding:1px 0 4px;vertical-align:top;width:34px;"><span style="display:block;width:22px;height:22px;border-radius:11px;background:#17171a;font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;font-size:12px;line-height:22px;font-weight:600;color:#ffffff;text-align:center;">3</span></td>
    <td style="padding:0 0 4px;font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.6;color:#17171a;"><strong style="font-weight:600;">Get told when it's done.</strong> Add a callback URL to a job and we POST a signed webhook when it finishes. The <a href="{{ docs_link }}" style="color:#17171a;text-decoration:underline;text-decoration-color:#a1a1aa;text-underline-offset:3px;">docs</a> have recipes.</td>
  </tr>
</table>
{{ button(app_link, "Open the dashboard") }}
{% endblock %}
